# Copia este archivo como .env y ajusta valores.
# cp .env.example .env

# ── Base de datos MySQL ─────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=accesclass

# ── Autenticación JWT ───────────────────────────────────────────
# Cambiar en producción (cadena larga y aleatoria)
SECRET_KEY=speakinghands_secret_2026

# ── Motores de voz (servidor) ───────────────────────────────────
# auto | google | whisper
VOZ_PREFERIR=auto
GOOGLE_SPEECH_TIMEOUT=4
# Opcional: clave API de Google Cloud Speech (si no, usa API pública limitada)
# GOOGLE_SPEECH_API_KEY=

# ── Whisper local (faster-whisper) ───────────────────────────────
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
# WHISPER_CACHE_DIR=./models/whisper
# WHISPER_MODEL_PATH=

# ── Simulación de fallos Google (solo desarrollo / pruebas) ───────
# VOZ_SIMULAR_GOOGLE_CAIDO=1
# VOZ_SIMULAR_GOOGLE_NAVEGADOR=1
# VOZ_SIMULAR_GOOGLE_SERVIDOR=1
